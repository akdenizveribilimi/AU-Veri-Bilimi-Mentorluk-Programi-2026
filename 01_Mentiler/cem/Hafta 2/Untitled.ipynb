   "source": [
    "inputArray = input().split()\n",
    "i = len(inputArray)\n",
    "bigger5 = []\n",
    "lower5 = []\n",
    "while i > 0:\n",
    "    if int(inputArray[i-1])>5:\n",
    "        bigger5.append(int(inputArray[i-1]))\n",
    "    else:\n",
    "        lower5.append(int(inputArray[i-1]))\n",
    "    i=i-1\n",
    "print(bigger5)\n",
    "print(lower5)\n"
   ]
